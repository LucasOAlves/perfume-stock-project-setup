NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://shared_stock:shared_stock@localhost:5432/shared_stock
# Used ONLY by the integration test suite (apps/api/test/integration). MUST point at a
# separate database from DATABASE_URL above — the suite TRUNCATEs its tables between every
# test. If unset, tests fall back to DATABASE_URL and will silently wipe your dev data.
TEST_DATABASE_URL=postgres://shared_stock:shared_stock@localhost:5432/shared_stock_test
SESSION_COOKIE_SECRET=change-me-to-a-long-random-string
# "console" (default): logs the code to the API terminal instead of sending anything —
# fine for local dev, never use in production. "twilio": sends a real SMS via Twilio's
# Messages API — requires the three TWILIO_* vars below. See
# docs/decisions/ADR-009-otp-delivery-channel.md.
OTP_SENDER=console
# Only read when OTP_SENDER=twilio. From your Twilio console (console.twilio.com) and a
# phone number you've bought/verified there — this project cannot create that account for you.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+15550006789
# "none" (default): manual product entry only, no outbound calls. "openbeautyfacts"
# opts into a real, free, no-credential third-party lookup for the barcode-scan
# pre-fill feature — see docs/decisions/ADR-005-catalog-provider.md before enabling.
CATALOG_PROVIDER=none
